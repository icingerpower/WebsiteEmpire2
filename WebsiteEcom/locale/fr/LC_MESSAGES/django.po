#: campaigns/admin.py:162
msgid "Title"
msgstr "Titre"

#: campaigns/admin.py:164
msgid "Customer-visible offer title (stored in offer_config_json['title'])."
msgstr "Titre de l'offre visible par le client (stocké dans offer_config_json['title'])."

#: campaigns/admin.py:171
msgid "Description"
msgstr "Description"

#: campaigns/admin.py:172
msgid "Customer-visible offer description."
msgstr "Description de l'offre visible par le client."

#: campaigns/admin.py:177
msgid "CTA label"
msgstr "Libellé du bouton d'appel à l'action"

#: campaigns/admin.py:178
msgid "Call-to-action button text shown to the shopper."
msgstr "Texte du bouton d'appel à l'action affiché au client."

#: campaigns/admin.py:183
msgid "Charge amount (cents)"
msgstr "Montant facturé (centimes)"

#: campaigns/admin.py:185
msgid ""
"Amount charged for off-session upsell, in cents (e.g. 999 = $9.99). Required "
"for all archetypes except storewide_discount."
msgstr ""
"Montant facturé pour une vente incitative hors session, en centimes (par "
"exemple 999 = 9,99 $). Requis pour tous les archétypes sauf storewide_discount."

#: campaigns/admin.py:194
msgid "Discount percent"
msgstr "Pourcentage de remise"

#: campaigns/admin.py:195
msgid "Percentage discount for storewide_discount steps (1–100)."
msgstr "Pourcentage de remise pour les étapes storewide_discount (1 à 100)."

#: campaigns/admin.py:200
msgid "Coupon expires after (days)"
msgstr "Le coupon expire après (jours)"

#: campaigns/admin.py:201
msgid "Days until the coupon expires. Default 30."
msgstr "Nombre de jours avant expiration du coupon. Par défaut : 30."

#: campaigns/admin.py:327
msgid "Translations"
msgstr "Traductions"

#: campaigns/admin.py:770
#, python-format
msgid ""
"The all-accepts path is %(steps)s steps deep. Shoppers rarely accept more "
"than 2–3 consecutive offers."
msgstr ""
"Le parcours \"tout accepter\" comporte %(steps)s étapes. Les clients "
"acceptent rarement plus de 2 à 3 offres consécutives."

#: campaigns/admin.py:776
msgid "A cycle was detected in the funnel graph — activation will be blocked."
msgstr "Un cycle a été détecté dans le graphe de l'entonnoir — l'activation sera bloquée."

#: campaigns/admin.py:1119 campaigns/admin.py:1181
msgid "No store context for this request."
msgstr "Aucun contexte de boutique pour cette requête."

#: campaigns/admin.py:1124 campaigns/admin.py:1186
msgid "Campaign not found or access denied."
msgstr "Campagne introuvable ou accès refusé."

#: campaigns/admin.py:1128 campaigns/admin.py:1190 campaigns/admin.py:1704
#: campaigns/admin.py:1751
msgid "You do not have permission to change this campaign."
msgstr "Vous n'avez pas la permission de modifier cette campagne."

#: campaigns/admin.py:1133
msgid "Platform campaigns cannot be modified from the store admin."
msgstr "Les campagnes de la plateforme ne peuvent pas être modifiées depuis l'admin de la boutique."

#: campaigns/admin.py:1140 campaigns/admin.py:1713
msgid "Step not found or does not belong to this campaign."
msgstr "Étape introuvable ou n'appartenant pas à cette campagne."

#: campaigns/admin.py:1147 campaigns/admin.py:1720
#, python-format
msgid "Step #%(step_pk)s is now the entry step for \"%(name)s\"."
msgstr "L'étape n°%(step_pk)s est maintenant l'étape d'entrée de « %(name)s »."

#: campaigns/admin.py:1195
msgid "Platform campaigns cannot be activated from the store admin."
msgstr "Les campagnes de la plateforme ne peuvent pas être activées depuis l'admin de la boutique."

#: campaigns/admin.py:1231 campaigns/admin.py:1786
#, python-format
msgid "Campaign \"%(name)s\" activated successfully."
msgstr "La campagne « %(name)s » a été activée avec succès."

#: campaigns/admin.py:1267 campaigns/admin.py:1822
