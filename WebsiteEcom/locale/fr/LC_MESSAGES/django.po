#: campaigns/templates/admin/campaigns/campaignstep/delete_confirmation.html:8
msgid "Warning: branch references will be cleared"
msgstr "Avertissement : les références de branche seront effacées"

#: campaigns/templates/admin/campaigns/campaignstep/delete_confirmation.html:11
msgid ""
"Deleting this step will set the following branch references to NULL (the "
"branch will become a terminal end-point):"
msgstr ""
"La suppression de cette étape mettra les références de branche suivantes à "
"NULL (la branche deviendra un point de terminaison) :"

