#: campaigns/admin.py:1404
msgid ""
"This campaign is active. Price and offer fields are locked to prevent "
"charging customers a different amount than shown."
msgstr ""
"Cette campagne est active. Les champs de prix et d'offre sont verrouillés "
"afin d'éviter de facturer aux clients un montant différent de celui affiché."

