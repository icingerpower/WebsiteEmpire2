msgstr "accept_next_step sur l'étape n°%(pk)s sera effacé"

#: campaigns/templates/admin/campaigns/campaignstep/delete_confirmation.html:29
msgid "Declining branch from:"
msgstr "Branche de refus depuis :"

#: campaigns/templates/admin/campaigns/campaignstep/delete_confirmation.html:36
#, python-format
