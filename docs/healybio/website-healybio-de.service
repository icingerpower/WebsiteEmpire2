[Unit]
Description=Healybio DE
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/websiteempire/healybio/deploy/de
ExecStart=/opt/websiteempire/healybio/StaticWebsiteServe --port 8096 --lang de --images-db /opt/websiteempire/healybio/deploy/images.db
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
